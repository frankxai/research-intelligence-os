diff --git a/scripts/tests/test_validate_skills.py b/scripts/tests/test_validate_skills.py
new file mode 100644
index 0000000..895a7df
--- /dev/null
+++ b/scripts/tests/test_validate_skills.py
@@ -0,0 +1,49 @@
+#!/usr/bin/env python3
+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+
+SCRIPT = os.path.join(os.path.dirname(os.path.dirname(__file__)), "validate_skills.py")
+
+
+def run(dirname, name, extra=""):
+    with tempfile.TemporaryDirectory() as root:
+        d = os.path.join(root, dirname)
+        os.makedirs(d)
+        with open(os.path.join(d, "SKILL.md"), "w", encoding="utf-8") as fh:
+            fh.write(f"---\nname: {name}\ndescription: Does a thing. Use when testing.\n{extra}---\nbody\n")
+        p = subprocess.run([sys.executable, SCRIPT, root], capture_output=True, text=True)
+        return p.returncode, p.stdout
+
+
+class TestValidateSkills(unittest.TestCase):
+    def test_valid(self):
+        self.assertEqual(run("my-skill", "my-skill")[0], 0)
+
+    def test_name_dir_mismatch(self):
+        rc, out = run("other-dir", "my-skill")
+        self.assertEqual(rc, 1)
+        self.assertIn("directory name", out)
+
+    def test_trailing_hyphen(self):
+        rc, _ = run("my-skill-", "my-skill-")
+        self.assertEqual(rc, 1)
+
+    def test_consecutive_hyphens(self):
+        rc, _ = run("my--skill", "my--skill")
+        self.assertEqual(rc, 1)
+
+    def test_leading_hyphen(self):
+        self.assertEqual(run("-my", "-my")[0], 1)
+
+    def test_compatibility_limit(self):
+        self.assertEqual(run("s", "s", "compatibility: " + "x" * 500 + "\n")[0], 0)
+        rc, out = run("s", "s", "compatibility: " + "x" * 501 + "\n")
+        self.assertEqual(rc, 1)
+        self.assertIn("compatibility", out)
+
+
+if __name__ == "__main__":
+    unittest.main()
