+SCRATCH_ROOTS = ("/tmp", "/var/tmp")
+RM_SHORT_OK = set("rRfFvdIi")
+RM_LONG_OK = {"--recursive", "--force", "--verbose", "--dir", "--preserve-root", "--one-file-system", "--interactive=never"}
+GLOB = re.compile(r"[*?\[]")
+
+
+def _scratch_roots() -> set[str]:
+    return {r for root in SCRATCH_ROOTS for r in (root, os.path.realpath(root))}
+
+
+def _inside_scratch(path: str) -> bool:
+    """True only if path resolves strictly below a scratch root (never the root itself)."""
+    real = os.path.realpath(path)
+    return any(real.startswith(r.rstrip("/") + "/") for r in _scratch_roots())
+
+
+def _resolve(tok: str, cwd):
+    """Absolute path for a literal token, or None when it cannot be known."""
+    if not tok or re.search(r"[$`{}\\!]|^~", tok) or ".." in tok.split("/"):
+        return None
+    if tok.startswith("/"):
+        return tok
+    return os.path.join(cwd, tok) if cwd else None
+
+
+def _target_safe(tok: str, cwd) -> bool:
+    full = _resolve(tok, cwd)
+    if full is None:
+        return False
+    if GLOB.search(full):
+        # Only the literal directory prefix is verifiable; it must itself be below scratch.
+        prefix, lead = [], ""
+        for part in full.split("/"):
+            if GLOB.search(part):
+                lead = part
+                break
+            prefix.append(part)
+        full = "/".join(prefix) or "/"
+        # `/tmp/build-*`: a literal alphanumeric lead keeps the match below the root
+        # (`/tmp/*` and `/tmp/.*` could match everything, or `..`).
+        if re.match(r"[A-Za-z0-9_][^*?\[]*", lead) and os.path.realpath(full) in _scratch_roots():
+            return True
+    return _inside_scratch(full)
+
+
+def _rm_args_safe(args: list[str], cwd) -> bool:
+    targets, opts_done, recursive = [], False, False
+    for a in args:
+        if not opts_done and a == "--":
+            opts_done = True
+        elif not opts_done and a.startswith("--"):
+            if a not in RM_LONG_OK:
+                return False
+            recursive = recursive or a == "--recursive"
+        elif not opts_done and a.startswith("-") and len(a) > 1:
+            if not set(a[1:]) <= RM_SHORT_OK:
+                return False
+            recursive = recursive or bool(set(a[1:]) & set("rR"))
+        else:
+            targets.append(a)
+    return bool(targets) and all(_target_safe(t, cwd) for t in targets)
+
+
+def rm_is_scratch_only(cmd: str, cwd=None) -> bool:
+    """True when every recursive rm in cmd provably targets only scratch paths."""
+    if "\n" in cmd or "\r" in cmd:
+        return False
+    try:
+        lex = shlex.shlex(cmd, posix=True, punctuation_chars=True)
+        lex.commenters = ""
+        lex.whitespace_split = True
+        toks = list(lex)
+    except ValueError:
+        return False
+    segs, cur = [], []
+    for t in toks:
+        if t in (";", "&&", "||"):
+            segs.append((cur, t))
+            cur = []
+        elif t and all(c in "();<>|&" for c in t):
+            return False  # pipes, subshells, redirects, background: not provable
+        else:
+            cur.append(t)
+    segs.append((cur, None))
+    if cwd and not os.path.isabs(cwd):
+        cwd = None
+    seen = 0
+    tainted = False  # a cd happened that a later ; or || could skip
+    for words, conn in segs:
+        if words and words[0] == "sudo":
+            words = words[1:]
+        if words and words[0] == "cd":
+            if len(words) == 2 and not words[1].startswith("-"):
+                dest = _resolve(words[1], cwd)
+                cwd = os.path.realpath(dest) if dest else None
+            else:
+                cwd = None
+            tainted = True
+        elif words and words[0] == "rm":
+            args = words[1:]
+            is_rec = any(
+                (a.startswith("--") and a == "--recursive") or (a.startswith("-") and not a.startswith("--") and set(a[1:]) & set("rR"))
+                for a in args if a != "--"
+            )
+            if is_rec:
+                seen += 1
+                if not _rm_args_safe(args, cwd):
+                    return False
+        if conn in (";", "||") and tainted:
+            cwd = None
+    needed = len(re.findall(RM_RECURSIVE, cmd, re.I))
+    return seen >= needed and seen > 0
+
 
