diff --git a/scripts/tests/test_validate_skills.py b/scripts/tests/test_validate_skills.py
new file mode 100644
index 0000000..57918c4
--- /dev/null
+++ b/scripts/tests/test_validate_skills.py
@@ -0,0 +1,67 @@
+import contextlib
+import io
+import os
+import sys
+import tempfile
+import unittest
+
+sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
+import validate_skills  # noqa: E402
+
+
+def run(root):
+    buf = io.StringIO()
+    with contextlib.redirect_stdout(buf):
+        rc = validate_skills.main([root])
+    return rc, buf.getvalue()
+
+
+class ValidateSkillsTests(unittest.TestCase):
+    def check(self, dirname, name, extra="", nested=None):
+        with tempfile.TemporaryDirectory() as tmp:
+            d = os.path.join(tmp, *(nested or []), dirname)
+            os.makedirs(d)
+            with open(os.path.join(d, "SKILL.md"), "w", encoding="utf-8") as f:
+                f.write(f"---\nname: {name}\ndescription: Does a thing. Use when testing.\n{extra}---\n\nBody\n")
+            return run(os.path.realpath(tmp))
+
+    def test_valid(self):
+        self.assertEqual(self.check("foo-bar", "foo-bar")[0], 0)
+
+    def test_nested_one_level(self):
+        self.assertEqual(self.check("foo", "foo", nested=["group"])[0], 0)
+
+    def test_dir_mismatch(self):
+        rc, out = self.check("foo", "bar")
+        self.assertEqual(rc, 1)
+        self.assertIn("parent directory", out)
+
+    def test_trailing_hyphen(self):
+        rc, out = self.check("foo-", "foo-")
+        self.assertEqual(rc, 1)
+        self.assertIn("start or end with a hyphen", out)
+
+    def test_leading_hyphen(self):
+        rc, out = self.check("-foo", "-foo")
+        self.assertEqual(rc, 1)
+        self.assertIn("start or end with a hyphen", out)
+
+    def test_consecutive_hyphens(self):
+        rc, out = self.check("foo--bar", "foo--bar")
+        self.assertEqual(rc, 1)
+        self.assertIn("consecutive hyphens", out)
+
+    def test_compat_500_ok(self):
+        self.assertEqual(self.check("foo", "foo", "compatibility: " + "a" * 500 + "\n")[0], 0)
+
+    def test_compat_501_fails(self):
+        rc, out = self.check("foo", "foo", "compatibility: " + "a" * 501 + "\n")
+        self.assertEqual(rc, 1)
+        self.assertIn("compatibility", out)
+
+    def test_missing_compat_ok(self):
+        self.assertEqual(self.check("foo", "foo")[0], 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
