@@ -59,8 +66,169 @@ ASK = [
     (r"\b(?:resend|sendgrid|mailchimp)\b[^|;&]*\b(?:send|broadcast|campaign)\b", "sending email to people"),
 ]
 
+SCRATCH_ROOTS = ("/tmp", "/var/tmp")
+_RM_FLAG = re.compile(r"^-[rRfvd]+$")
+_RM_LONG = {"--recursive", "--force", "--verbose", "--one-file-system", "--preserve-root", "--dir", "--interactive=never"}
+_BAD_CHARS = set("$`(){}<>\n\\")
+_GLOB = set("*?[]~!")
+_CWD_HEADS = {"pushd", "popd", "builtin", "command", "export", "set", "unset", "source", ".", "eval", "exec", "declare", "typeset", "local", "readonly"}
+_ASSIGN = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*\+?=")
+_RM_WORD = re.compile(r"(?:^|[\s/])rm(?:\s|$)")
+
+
+def _roots():
+    out = set(SCRATCH_ROOTS)
+    out.update(os.path.realpath(r) for r in SCRATCH_ROOTS)
+    return out
+
+
+def _inside(path, roots):
+    return any(path != r and path.startswith(r.rstrip("/") + "/") for r in roots)
+
+
+def _tokenize(cmd):
+    """Split into words and operators; quoted text is always a word. None on doubt."""
+    toks, buf, have, i, n = [], [], False, 0, len(cmd)
+
+    def flush():
+        nonlocal buf, have
+        if have:
+            toks.append(("w", "".join(buf)))
+        buf, have = [], False
+
+    while i < n:
+        c = cmd[i]
+        if c in "'\"":
+            j = cmd.find(c, i + 1)
+            if j < 0:
+                return None
+            buf.append(cmd[i + 1:j])
+            have = True
+            i = j + 1
+        elif c in " \t":
+            flush()
+            i += 1
+        elif c in ";&|":
+            flush()
+            j = i
+            while j < n and cmd[j] in ";&|":
+                j += 1
+            op = cmd[i:j]
+            if op not in (";", "&&", "||", "|", "&"):
+                return None
+            toks.append(("o", op))
+            i = j
+        else:
+            buf.append(c)
+            have = True
+            i += 1
+    flush()
+    return toks
+
+
+def _split(toks):
+    """-> list of (prev_op, words, next_op)."""
+    cmds, words, prev = [], [], None
+    for kind, val in toks:
+        if kind == "w":
+            words.append(val)
+        else:
+            if not words:
+                if val == ";" or val == "&":
+                    return None
+                return None
+            cmds.append((prev, words, val))
+            words, prev = [], val
+    if words:
+        cmds.append((prev, words, None))
+    return cmds
+
+
+def _clean_path(p):
+    return bool(p) and not (set(p) & _GLOB) and ".." not in p.split("/")
+
+
+def scratch_rm_ok(cmd, cwd):
+    """True only if every rm in cmd provably deletes strictly inside a scratch root."""
+    try:
+        if set(cmd) & _BAD_CHARS:
+            return False
+        toks = _tokenize(cmd)
+        if not toks:
+            return False
+        cmds = _split(toks)
+        if not cmds:
+            return False
+        roots = _roots()
+        cwds = {os.path.normpath(cwd)} if isinstance(cwd, str) and os.path.isabs(cwd) else None
+        vetted = 0
+        tainted = False
+        for prev, words, nxt in cmds:
+            if words[0] in _CWD_HEADS or any(_ASSIGN.match(w) or "CDPATH" in w for w in words):
+                tainted = True
+                cwds = None
+            if "ln" in words or any(os.path.basename(w) == "ln" for w in words):
+                return False
+            head = words[0]
+            if head == "cd" and not tainted:
+                args = words[1:]
+                if len(args) != 1 or args[0].startswith("-") or not _clean_path(args[0]):
+                    cwds = None
+                    continue
+                if prev in ("|", "&") or nxt in ("|", "&") or cwds is None:
+                    cwds = None
+                    continue
+                new = {os.path.normpath(os.path.join(c, args[0])) for c in cwds}
+                if not all(os.path.isdir(x) and os.access(x, os.X_OK) for x in new):
+                    cwds = None
+                    continue
+                if prev in (None, ";") and nxt in (None, ";", "&&"):
+                    cwds = new
+                else:
+                    cwds = cwds | new
+                continue
+            idx = 0
+            if head == "sudo":
+                idx = 1
+                if len(words) > 1 and words[1] == "-n":
+                    idx = 2
+            if idx >= len(words) or os.path.basename(words[idx]) != "rm":
+                if any(_RM_WORD.search(w) for w in words):
+                    return False
+                continue
+            vetted += 1
+            targets, dd = [], False
+            for a in words[idx + 1:]:
+                if dd:
+                    targets.append(a)
+                elif a == "--":
+                    dd = True
+                elif a.startswith("-") and len(a) > 1:
+                    if not (_RM_FLAG.match(a) or a in _RM_LONG):
+                        return False
+                else:
+                    targets.append(a)
+            if not targets:
+                return False
+            for t in targets:
+                if not _clean_path(t):
+                    return False
+                if os.path.isabs(t):
+                    bases = [None]
+                else:
+                    if cwds is None:
+                        return False
+                    bases = sorted(cwds)
+                for b in bases:
+                    ab = os.path.normpath(t if b is None else os.path.join(b, t))
+                    if not _inside(ab, SCRATCH_ROOTS) or not _inside(os.path.realpath(ab), roots):
+                        return False
+        return vetted > 0
+    except Exception:
+        return False
+
 
